---
import { getCollection } from "astro:content";
import Layout from "@/layouts/BaseLayout.astro";
import HeroHome from "@/components/section/HeroHome.astro";
import Section from "@/components/wrapper/Section.astro";
import HeaderSplit from "@/components/content/HeaderSplit.astro";
import FeatureProduct from "@/components/content/FeatureProduct.astro";
import RefillStory from "@/components/section/RefillStory.astro";
import DisplayPair from "@/components/content/DisplayPair.astro";
import IntroStory from "@/components/content/IntroStory.astro";
import bodyOilModel from "@/assets/images/bodyoil-model.jpg";
import ProductGrid from "@/components/content/ProductGrid.astro";

const products = (await getCollection("products", (p) => p.data.listed)).sort((a, b) => a.data.order - b.data.order);
import oilModel from "@/assets/images/oil-model.jpg";
import beautifulOil from "@/assets/images/the-beautiful-oil.jpg";
import oilDrops from "@/assets/images/oil-drops.jpg";
import PressLogos from "@/components/content/PressLogos.astro";
import ArticleCard from "@/components/content/ArticleCard.astro";
import Grid from "@/components/wrapper/Grid.astro";
import vogue from "@/assets/images/press/vogue.png";
import elle from "@/assets/images/press/elle.png";
import allure from "@/assets/images/press/allure.png";
import byrdie from "@/assets/images/press/byrdie.png";
import glamour from "@/assets/images/press/glamour.png";
import essence from "@/assets/images/press/essence.png";
import papayaRitual from "@/assets/images/journal/papaya-ritual.jpg";
import dropperSerum from "@/assets/images/journal/dropper-serum.jpg";
---

<Layout>
  {/* Hero */}
  <HeroHome
    title="Beautiful,"
    accent="again"
    text="Certified organic beauty, in cases made to be kept for life — and refilled."
    buttonLabel="Shop the Iconic Edition"
    buttonHref="#"
    meta={[
      "Since 2010",
      "Vegan · CCPB certified organic",
      "Refillable since day one",
    ]}
    model="/models/kjaerweis-lipstick-twist.glb"
    environment="/env/studio_small_09_1k.hdr"
  />

  {/* The Oil Edit */}
  <Section paddingBottom="small" gap="6">
    <HeaderSplit
      tag="Seasonal · Winter ritual"
      title="The Oil Edit"
      text="Three cold-pressed oils for the dark months: for face, body and the ends of your hair. One golden ritual, refilled again and again."
    />
    <FeatureProduct
      name="The Beautiful Oil"
      description="Lightweight active facial oil for a healthy, radiant glow."
      sizes={[
        { label: "65 ml", price: "$229" },
        { label: "30 ml", price: "$149" },
        { label: "3 ml", price: "$25" },
      ]}
      selected={1}
      tag="Bestseller"
      packshot={beautifulOil}
      texture={oilDrops}
      lifestyle={oilModel}
      lifestyleAlt="Model holding The Beautiful Oil against her cheek, winking"
    />
  </Section>

  {/* Refill story */}
  <RefillStory
    title="One case."
    accent="Endless refills"
    text="Since 2010 — the first luxury beauty brand to launch with refillable packaging."
    steps={[
      "Keep the case — it is made for life.",
      "Order the refill when you run out.",
      "Slip it in. Recycle the red box. Repeat.",
    ]}
    buttonLabel="How refills work"
    model="/models/kjaerweis-lipstick.glb"
  />

  {/* About */}
  <Section theme="cream" paddingTop="small" paddingBottom="small" gap="0">
    <DisplayPair
      title="Luxury"
      accent="that cares"
      variant="display"
      mobile={{
        width: 350,
        height: 118,
        column: 350,
        line: { x: -4, y: 0, size: 72 },
        accent: { x: 118, y: 47, size: 66 },
      }}
      desktop={{
        width: 1360,
        height: 470,
        column: 1360,
        line: { x: -10, y: 0, size: 200 },
        accent: { x: 406, y: 130, size: 190 },
      }}
    />
    <IntroStory
      image={bodyOilModel}
      imageAlt="Model holding The Body Oil against her back"
      title="Beautiful objects for life."
      text="Founded in 2010 on the belief that beauty is more than skin deep. Certified-organic formulas, hand-selected ingredients and cases made to be kept and treasured — cultivating an alluring patina with time."
      buttonLabel="Read our story"
    />
  </Section>

  {/* Product grid */}
  <Section gap="0" id="skin-care">
    <ProductGrid
      title="Skin Care"
      products={products}
      filters={[
        { label: "All", value: "all" },
        { label: "Face", value: "face" },
        { label: "Body", value: "body" },
        { label: "Lips", value: "lips" },
        { label: "Refills", value: "refills" },
        { label: "Sets", value: "sets" },
      ]}
      buttonLabel="Shop all skin care"
    />
  </Section>

  {/* Journal & press */}
  <Section theme="cream" paddingBottom="medium" gap="6">
    <PressLogos
      logos={[
        { name: "Vogue", image: vogue },
        { name: "Elle", image: elle },
        { name: "Allure", image: allure },
        { name: "Byrdie", image: byrdie },
        { name: "Glamour", image: glamour },
        { name: "Essence", image: essence },
      ]}
    />
    <HeaderSplit
      title="The Guide"
      headingVariant="h2"
      text="Rituals, ingredients and the craft behind every refill."
    />
    <Grid medium={3} class="gap-row-6">
      <ArticleCard
        category="Ingredients"
        title="Root of Light, explained"
        meta="4 min read"
        image={oilDrops}
        imageAlt="Two drops of golden oil"
      />
      <ArticleCard
        category="Rituals"
        title="The three-step daily routine"
        meta="6 min read"
        image={papayaRitual}
        imageAlt="A serum bottle resting in a halved papaya"
      />
      <ArticleCard
        category="Craft"
        title="Why we refill, not replace"
        meta="5 min read"
        image={dropperSerum}
        imageAlt="A dropper above drops of clear serum"
      />
    </Grid>
  </Section>
</Layout>
