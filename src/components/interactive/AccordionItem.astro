---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/typography/Heading.astro";
import PlusIcon from "@lucide/astro/icons/plus";
import MinusIcon from "@lucide/astro/icons/minus";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"details"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Item heading. */
  heading?: string;
  /** Heading level. */
  headingTag?: "h2" | "h3" | "h4" | "h5" | "h6";
  /** Open on load. */
  open?: boolean;
};

const {
  render = true,
  heading,
  headingTag = "h3",
  open = false,
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{render && heading && content && (
  <details
    class:list={["accordion_item", className]}
    open={open}
    data-accordion-group
    {...rest}
  >
    <summary class="accordion_toggle">
      <Heading tag={headingTag} variant="inherit" class="accordion_title text-style-label">
        {heading}
      </Heading>
      <span class="accordion_icon" aria-hidden="true">
        <PlusIcon class="accordion_plus" stroke-width={1.25} />
        <MinusIcon class="accordion_minus" stroke-width={1.25} />
      </span>
    </summary>

    <div class="accordion_body margin-trim">
      <Fragment set:html={content} />
    </div>
  </details>
)}

<style is:global>
  @layer components {
    .accordion_item {
      interpolate-size: allow-keywords;
      border-top: var(--border-width) solid var(--text);
    }

    .accordion_toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding-block: 1rem 1.5rem;
      list-style: none;
      cursor: pointer;
      &::-webkit-details-marker {
        display: none;
      }
    }

    .accordion_title {
      margin-block: 0;
    }

    .accordion_icon {
      flex: none;
      display: grid;
      width: 1.375rem;
      height: 1.375rem;

      & svg {
        grid-area: 1 / 1;
        width: 100%;
        height: 100%;
        transition: opacity var(--open-duration) var(--open-ease);
      }
    }

    .accordion_minus {
      opacity: 0;
    }

    .accordion_item:is([open], .stacki-opened) .accordion_icon,
    .stacki-designer .accordion_wrap.preview .accordion_icon {
      & .accordion_plus {
        opacity: 0;
      }
      & .accordion_minus {
        opacity: 1;
      }
    }

    .accordion_item::details-content {
      block-size: 0;
      overflow: hidden;
      content-visibility: hidden;
    }

    @supports (interpolate-size: allow-keywords) {
      .accordion_item::details-content {
        transition:
          block-size var(--open-duration) var(--open-ease),
          content-visibility var(--open-duration) var(--open-ease)
            allow-discrete;
      }
    }

    .accordion_item:is([open], .stacki-opened)::details-content,
    .stacki-designer .accordion_wrap.preview .accordion_item::details-content {
      block-size: auto;
      content-visibility: visible;
    }

    /* Open: the body sits 12px under the title and takes over the 24px foot. */
    .accordion_toggle {
      transition: padding-bottom var(--open-duration) var(--open-ease);
    }

    .accordion_item:is([open], .stacki-opened) .accordion_toggle {
      padding-bottom: 0.75rem;
    }

    .accordion_body {
      padding-right: 1.5rem;
      padding-bottom: 1.5rem;
    }
  }
</style>
