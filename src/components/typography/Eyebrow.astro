---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** HTML element. */
  tag?: "span" | "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Eyebrow style. */
  variant?: "default" | "tag" | "tag-photo";
};

const {
  render = true,
  tag: Tag = "p",
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{render && content && (
  <div
    class:list={["eyebrow_wrap", variant !== "default" && variant, className]}
    {...rest}
  >
    {variant === "default" && (
      <span class="eyebrow_marker" aria-hidden="true" />
    )}
    <Tag
      class:list={[
        "eyebrow_text",
        variant === "default" ? "text-style-small" : "text-style-overline",
      ]}
    >
      <Fragment set:html={content} />
    </Tag>
  </div>
)}

<style is:global>
  @layer components {
    .eyebrow_wrap {
      display: inline-flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: var(--space-2);

      &.tag {
        background-color: color-mix(in lab, var(--brand-500) 8%, transparent);
        color: var(--brand-500);
        padding: 0.6rem 0.75rem;
        border-radius: var(--radius-round);
      }

      &.tag-photo {
        background-color: color-mix(in lab, var(--light-100) 55%, transparent);
        color: var(--dark-900);
        padding: 0.6rem 0.75rem;
        border-radius: var(--radius-round);
        backdrop-filter: blur(var(--blur-small));
        -webkit-backdrop-filter: blur(var(--blur-small));
      }
      .eyebrow_marker {
        flex: none;
        width: var(--border-width);
        height: 0.75rem;
        background-color: currentcolor;
      }
    }
  }
</style>
