---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Base = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** HTML element. */
  tag?: "span" | "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
};

type Props = Base &
  (
    | {
        /** Eyebrow style. */
        variant?: "default";
        tone?: never;
        surface?: never;
      }
    | {
        variant: "tag";
        /** Tag colour. */
        tone?: "neutral" | "accent" | "accent-filled";
        /** What the tag sits on. `photo` adds a frosted backdrop. */
        surface?: "solid" | "photo";
      }
  );

type AllProps = Base & {
  variant?: "default" | "tag";
  tone?: "neutral" | "accent" | "accent-filled";
  surface?: "solid" | "photo";
};

const {
  render = true,
  tag: Tag = "p",
  variant = "default",
  tone = "accent",
  surface = "solid",
  class: className,
  ...rest
} = Astro.props as AllProps;

const isTag = variant === "tag";
const content = await slotContent(Astro.slots);
---

{render && content && (
  <div
    class:list={[
      "eyebrow_wrap",
      isTag && "tag",
      isTag && tone,
      isTag && surface === "photo" && "photo",
      className,
    ]}
    {...rest}
  >
    {!isTag && <span class="eyebrow_marker" aria-hidden="true" />}
    <Tag class:list={["eyebrow_text", isTag ? "text-style-overline" : "text-style-small"]}>
      <Fragment set:html={content} />
    </Tag>
  </div>
)}

<style is:global>
  @layer components {
    .eyebrow_wrap {
      display: inline-flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: var(--space-2);

      &.tag {
        --_tag-ink: var(--brand-500);
        --_tag-fill: color-mix(in lab, var(--brand-500) 8%, transparent);
        padding: 0.6rem 0.75rem;
        background-color: var(--_tag-fill);
        color: var(--_tag-ink);
        border-radius: var(--radius-round);
        white-space: nowrap;
      }

      &.tag.neutral {
        --_tag-ink: var(--text);
        --_tag-fill: color-mix(in lab, var(--text) 6%, transparent);
      }

      &.tag.photo {
        --_tag-fill: color-mix(in lab, var(--light-100) 55%, transparent);
        backdrop-filter: blur(var(--blur-small));
        -webkit-backdrop-filter: blur(var(--blur-small));
      }

      &.tag.neutral.photo {
        --_tag-ink: var(--dark-900);
      }

      &.tag.accent-filled {
        --_tag-ink: var(--brand-text);
        --_tag-fill: var(--brand-500);
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
      }

      .eyebrow_marker {
        flex: none;
        width: var(--border-width);
        height: 0.75rem;
        background-color: currentcolor;
      }
    }
  }
</style>
