---
import type { HTMLAttributes } from "astro/types";
import { Image } from "astro:assets";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Choice from "@/components/form/Choice.astro";
import Button from "@/components/Button.astro";
import { slug } from "@/utils/slug.ts";

type Size = {
  /** Size label, e.g. `30 ml`. */
  label: string;
  /** Price for this size. */
  price: string;
};

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Product name. */
  name: string;
  /** Short product description. */
  description?: string;
  /** Size options with their prices. The first is selected. */
  sizes: Size[];
  /** Tag over the packshot. */
  tag?: string;
  /** Packshot on the surface colour. */
  packshot: ImageMetadata;
  /** Texture shown when the packshot is hovered. */
  texture?: ImageMetadata;
  /** Lifestyle photo beside the product. */
  lifestyle: ImageMetadata;
  /** Lifestyle photo description. */
  lifestyleAlt?: string;
  /** Button label. */
  buttonLabel?: string;
};

const {
  render = true,
  name,
  description,
  sizes = [],
  tag,
  packshot,
  texture,
  lifestyle,
  lifestyleAlt = "",
  buttonLabel = "Add to bag",
  class: className,
  ...rest
} = Astro.props;

const group = `size-${slug(name)}`;
---

{render && name && sizes.length > 0 && packshot && lifestyle && (
  <div class:list={["feature-product_wrap", className]} {...rest}>
    <div class="feature-product_lifestyle">
      <Image
        class="feature-product_photo"
        src={lifestyle}
        alt={lifestyleAlt}
        widths={[480, 800, 1200, 1600]}
        sizes="(width >= 64rem) 55vw, 100vw"
      />
    </div>

    <div class="feature-product_product">
      <div class="feature-product_visual">
        <div class="feature-product_bottle">
          <Image
            class="feature-product_packshot"
            src={packshot}
            alt={name}
            widths={[480, 800, 1200]}
            sizes="(width >= 64rem) 40vw, 100vw"
          />
          {texture && (
            <Image
              class="feature-product_texture"
              src={texture}
              alt=""
              widths={[480, 800, 1200]}
              sizes="(width >= 64rem) 40vw, 100vw"
            />
          )}
        </div>
        <div class="feature-product_tag">
          <Eyebrow variant="tag-photo" tag="span">{tag}</Eyebrow>
        </div>
      </div>

      <div class="feature-product_title">
        <h3 class="text-style-h4">{name}</h3>
        <p class="feature-product_price text-style-price" aria-live="polite">
          {sizes[0].price}
        </p>
      </div>

      {description && <p class="text-style-main">{description}</p>}

      <fieldset class="feature-product_sizes">
        <legend class="sr-only">Size</legend>
        {sizes.map((size, index) => (
          <Choice
            type="radio"
            variant="chip"
            name={group}
            label={size.label}
            value={size.label}
            checked={index === 0}
            data-price={size.price}
          />
        ))}
      </fieldset>

      <Button size="large" icon="bag">{buttonLabel}</Button>
    </div>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>(".feature-product_product").forEach((product) => {
    const price = product.querySelector<HTMLElement>(".feature-product_price");
    product.addEventListener("change", (event) => {
      const input = event.target;
      if (!price || !(input instanceof HTMLInputElement) || !input.dataset.price) return;
      price.textContent = input.dataset.price;
    });
  });
</script>

<style is:global>
  @layer components {
    .feature-product_wrap {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }

    .feature-product_lifestyle {
      position: relative;
      aspect-ratio: 350 / 340;
      overflow: hidden;
      background-color: var(--background);
    }

    .feature-product_photo {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .feature-product_product {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .feature-product_visual {
      position: relative;
      aspect-ratio: 555 / 520;
      overflow: hidden;
      background-color: var(--background);
    }

    /* The packshot is cropped 16.71% top and bottom, as in the design. */
    .feature-product_bottle {
      position: absolute;
      inset: -16.71% 0;
    }

    .feature-product_packshot,
    .feature-product_texture {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .feature-product_packshot,
    .feature-product_texture {
      transition: opacity calc(var(--hover-duration) * 3) var(--hover-ease);
    }

    .feature-product_texture {
      opacity: 0;
      mix-blend-mode: multiply;
    }

    @media (hover: hover) {
      .feature-product_visual:hover {
        & .feature-product_texture {
          opacity: 1;
        }
        & .feature-product_packshot {
          opacity: 0;
        }
      }
    }

    .feature-product_tag {
      position: absolute;
      top: 1.25rem;
      left: 1.25rem;
    }

    .feature-product_title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      white-space: nowrap;
    }

    .feature-product_sizes {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin: 0;
      padding: 0;
      border: 0;
    }

    @media (width >= 64rem) {
      .feature-product_wrap {
        grid-template-columns: minmax(0, 785fr) minmax(0, 555fr);
      }

      .feature-product_lifestyle {
        aspect-ratio: auto;
        height: 100%;
      }
    }
  }
</style>
