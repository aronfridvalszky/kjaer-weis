---
import type { HTMLAttributes } from "astro/types";
import { Image } from "astro:assets";
import Button from "@/components/Button.astro";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Portrait beside the text. */
  image: ImageMetadata;
  /** Image description. */
  imageAlt?: string;
  /** Short serif title. */
  title: string;
  /** Body text. */
  text?: string;
  /** Button label. */
  buttonLabel?: string;
  /** Button destination. */
  buttonHref?: string;
};

const {
  render = true,
  image,
  imageAlt = "",
  title,
  text,
  buttonLabel,
  buttonHref = "#",
  class: className,
  ...rest
} = Astro.props;
---

{render && image && title && (
  <div class:list={["intro-story_wrap", className]} {...rest}>
    <div class="intro-story_visual">
      <Image
        class="intro-story_image"
        src={image}
        alt={imageAlt}
        widths={[400, 650, 1000]}
        sizes="(width >= 64rem) 24vw, 85vw"
      />
    </div>
    <div class="intro-story_text">
      <h3 class="text-style-h4">{title}</h3>
      {text && <p class="text-style-large">{text}</p>}
      {buttonLabel && (
        <Button element="link" href={buttonHref} emphasis="secondary" icon="arrow">
          {buttonLabel}
        </Button>
      )}
    </div>
  </div>
)}

<style is:global>
  @layer components {
    .intro-story_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .intro-story_visual {
      position: relative;
      width: min(100%, 20.3125rem);
      aspect-ratio: 325 / 440;
      overflow: hidden;
      background-color: var(--light-200);
    }

    .intro-story_image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .intro-story_text {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    /* Desktop: 460 lead-in · 325 image · 135 air · 440 text, of 1360. */
    @media (width >= 64rem) {
      .intro-story_wrap {
        display: grid;
        grid-template-columns:
          minmax(0, 460fr) minmax(0, 325fr) minmax(0, 135fr)
          minmax(0, 440fr);
        align-items: end;
        gap: 0;
      }

      .intro-story_visual {
        grid-column: 2;
        width: 100%;
      }

      .intro-story_text {
        grid-column: 4;
      }
    }
  }
</style>
