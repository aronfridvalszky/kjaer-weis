---
import type { ComponentProps } from "astro/types";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Section from "@/components/wrapper/Section.astro";
import Button from "@/components/Button.astro";
import DisplayPair from "@/components/content/DisplayPair.astro";

type Step = {
  /** Step text. */
  text: string;
  /** Photo shown while the step is active. */
  image: ImageMetadata;
  /** Photo description. */
  imageAlt?: string;
};

type Props = Pick<ComponentProps<typeof Section>, "render" | "theme"> & {
  /** First display line. */
  title: string;
  /** Accent line set over the first. */
  accent: string;
  /** Short text beside the title. */
  text?: string;
  /** Numbered steps, played as a scroll carousel. */
  steps?: Step[];
  /** Button label. */
  buttonLabel?: string;
  /** Button destination. */
  buttonHref?: string;
};

const {
  render = true,
  title,
  accent,
  text,
  steps = [],
  buttonLabel,
  buttonHref = "#",
  theme = "dark",
  ...rest
} = Astro.props;
---

{render && title && accent && (
  <Section theme={theme} paddingTop="none" paddingBottom="none" gap="0" data-refill-story {...rest}>
    <div class="refill-story_wrap">
      <div class="refill-story_header">
        <div class="refill-story_title">
          <DisplayPair
            title={title}
            accent={accent}
            mobile={{
              width: 350,
              height: 116,
              column: 350,
              line: { x: -4, y: 0, size: 56 },
              accent: { x: 36, y: 47, size: 60 },
            }}
            desktop={{
              width: 1000,
              height: 330,
              column: 1360,
              line: { x: -10, y: 0, size: 140 },
              accent: { x: 289, y: 113, size: 190 },
            }}
          />
        </div>
        {text && <p class="refill-story_text text-style-small">{text}</p>}
      </div>

      <div class="refill-story_content">
        {steps.length > 0 && (
          <div class="refill-story_visual">
            {steps.map((step) => (
              <div class="refill-story_slide">
                <Image
                  src={step.image}
                  alt={step.imageAlt ?? ""}
                  widths={[320, 480, 720, 960]}
                  sizes="(width >= 64rem) 32vw, 60vw"
                />
              </div>
            ))}
          </div>
        )}

        <div class="refill-story_steps">
          {steps.length > 0 && (
            <ol class="refill-story_list">
              {steps.map((step, index) => (
                <li class="refill-story_step" style={`--_p: ${index === 0 ? 1 : 0}`}>
                  <span class="refill-story_num" aria-hidden="true">
                    <span class="refill-story_num-small">{String(index + 1).padStart(2, "0")}</span>
                    <span class="refill-story_num-large">{String(index + 1).padStart(2, "0")}</span>
                  </span>
                  <span class="refill-story_label">{step.text}</span>
                </li>
              ))}
            </ol>
          )}
          {buttonLabel && (
            <div class="refill-story_button">
              <Button element="link" href={buttonHref} emphasis="secondary" icon="arrow" class="width-full">
                {buttonLabel}
              </Button>
            </div>
          )}
        </div>
      </div>
    </div>
  </Section>
)}

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  /* Without motion the markup's own state shows: step one active, its photo in place. */
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  /* Scroll per step change, in viewport heights. */
  const STEP_SCROLL = 1;

  document.querySelectorAll<HTMLElement>("[data-refill-story]").forEach((section) => {
    const steps = gsap.utils.toArray<HTMLElement>(".refill-story_step", section);
    const slides = gsap.utils.toArray<HTMLElement>(".refill-story_slide", section);
    if (prefersReduced.matches || steps.length === 0) return;

    const photo = (slide: HTMLElement | undefined) => slide?.querySelector("img") ?? null;

    /* Opening state: no step active, no photo. */
    gsap.set(steps, { "--_p": 0 });
    gsap.set(slides, { yPercent: 100, opacity: 1 });
    gsap.set(slides.map(photo), { yPercent: -60 });

    const timeline = gsap.timeline({
      defaults: { duration: 1, ease: "power2.inOut" },
      scrollTrigger: {
        trigger: section,
        start: "top top",
        end: () => `+=${window.innerHeight * STEP_SCROLL * (steps.length + 1)}`,
        pin: true,
        /* The parent is a flex column, where GSAP turns spacing off by default. */
        pinSpacing: true,
        scrub: 0.6,
        snap: {
          snapTo: (value, self) => snapToStep(value, self?.direction ?? 1),
          duration: { min: 0.2, max: 0.6 },
          delay: 0.08,
          ease: "power1.inOut",
        },
        invalidateOnRefresh: true,
      },
    });

    timeline.addLabel("start", 0);
    let time = 0;
    steps.forEach((step, index) => {
      const slide = slides[index];
      const previous = slides[index - 1];

      /* The step text grows while the one before shrinks back. */
      timeline.to(step, { "--_p": 1 }, time);
      if (index > 0) timeline.to(steps[index - 1], { "--_p": 0 }, time);

      /* The photo leaves upward out of its frame as the next one rises in. */
      if (slide) {
        timeline.to(slide, { yPercent: 0 }, time).to(photo(slide), { yPercent: 0 }, time);
      }
      if (previous) {
        timeline.to(previous, { yPercent: -100 }, time).to(photo(previous), { yPercent: 60 }, time);
      }

      timeline.addLabel(`step-${index + 1}`, time + 1);
      time += 1.5;
    });

    /* A short hold on the last step before the page scrolls on. */
    timeline.to({}, { duration: 1 }, time - 0.5);

    /*
     * Snap to the steps in the scroll direction. Past the last step nothing snaps,
     * so the user scrolls through a short hold and on to the next section.
     */
    function snapToStep(value: number, direction: number) {
      const points = ["start", ...steps.map((_, index) => `step-${index + 1}`)].map(
        (label) => timeline.labels[label] / timeline.duration(),
      );
      const last = points[points.length - 1];
      if (value >= last) return value;
      if (direction > 0) return points.find((point) => point >= value) ?? last;
      return [...points].reverse().find((point) => point <= value) ?? 0;
    }
  });
</script>

<style is:global>
  @layer components {
    .refill-story_wrap {
      --_top: clamp(5rem, 11svh, 7.5rem);
      --_bottom: clamp(1.25rem, 4svh, 2.5rem);
      /* Step text: small and active sizes, both held to the viewport height. */
      --_small: min(1.0625rem, 2.6svh);
      --_large: min(1.625rem, 4svh);
      --_row: min(0.625rem, 1.4svh);
      width: 100%;
      height: 100svh;
      display: flex;
      flex-direction: column;
      gap: min(1rem, 2svh);
      padding-top: var(--_top);
      padding-bottom: var(--_bottom);
    }

    .refill-story_header {
      display: flex;
      flex-direction: column;
      gap: min(0.75rem, 1.5svh);
    }

    /* Keep the title to about a quarter of the screen height. */
    .refill-story_title {
      width: min(100%, 72svh);
    }

    .refill-story_text {
      max-width: 20.625rem;
    }

    /* Short phones: give the photo the room. */
    @media (width < 48rem) and (height < 45rem) {
      .refill-story_text {
        display: none;
      }
    }

    .refill-story_content {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
      gap: min(1rem, 2svh);
    }

    /* Photo frame: fills the free height, slides move inside it. */
    .refill-story_visual {
      position: relative;
      flex: 1;
      min-height: 0;
      height: 100%;
      aspect-ratio: 2 / 3;
      align-self: center;
      overflow: hidden;
    }

    .refill-story_slide {
      position: absolute;
      inset: 0;
      overflow: hidden;
      will-change: transform;

      /* Without the script only the first photo shows. */
      &:not(:first-child) {
        opacity: 0;
      }

      & img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        will-change: transform;
      }
    }

    .refill-story_steps {
      display: flex;
      flex-direction: column;
      gap: min(1rem, 2svh);
    }

    .refill-story_step {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      padding-block: var(--_row);
      border-top: var(--border-width) solid var(--text);
    }

    /* Numbers: the small sans and the large serif crossfade as the step grows. */
    .refill-story_num {
      display: grid;
      flex: none;
      font-size: calc(0.8125rem + (var(--_large) * 0.5 - 0.8125rem) * var(--_p));
      line-height: 1.35;

      & > span {
        grid-area: 1 / 1;
      }
    }

    .refill-story_num-small {
      font-family: var(--primary-family);
      opacity: calc(1 - var(--_p));
    }

    .refill-story_num-large {
      font-family: var(--serif-family);
      opacity: var(--_p);
    }

    .refill-story_label {
      font-family: var(--serif-family);
      font-size: calc(var(--_small) + (var(--_large) - var(--_small)) * var(--_p));
      line-height: calc(1.2 - 0.15 * var(--_p));
      max-width: 30.1875rem;
    }

    .refill-story_button {
      display: flex;
      flex-direction: column;
    }

    @media (width >= 48rem) {
      .refill-story_wrap {
        --_small: min(1.5rem, 3svh);
        --_large: min(3rem, 5.5svh);
        --_row: min(1.125rem, 1.8svh);
      }

      .refill-story_step {
        gap: 2.5rem;
      }

      .refill-story_title {
        width: min(100%, 107svh);
      }
    }

    @media (width >= 64rem) {
      .refill-story_wrap {
        --_small: min(1.875rem, 3.2svh);
        --_large: min(4rem, 6svh);
        --_row: min(1.375rem, 2svh);
        gap: min(1.5rem, 2.5svh);
      }

      .refill-story_header {
        flex-direction: row;
        align-items: start;
        justify-content: space-between;
      }

      .refill-story_text {
        width: 20.625rem;
      }

      .refill-story_content {
        flex-direction: row-reverse;
        align-items: end;
        justify-content: space-between;
        gap: 1.25rem;
      }

      .refill-story_visual {
        flex: none;
        align-self: stretch;
      }

      .refill-story_steps {
        flex: none;
        width: 35rem;
        gap: min(2.5rem, 4svh);
      }

      .refill-story_button {
        width: 27.5rem;
      }
    }
  }
</style>
