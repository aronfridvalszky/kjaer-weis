---
import type { ComponentProps } from "astro/types";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Section from "@/components/wrapper/Section.astro";
import Button from "@/components/Button.astro";
import DisplayPair from "@/components/content/DisplayPair.astro";

type Step = {
  /** Step text. */
  text: string;
  /** Photo shown while the step is active. */
  image: ImageMetadata;
  /** Photo description. */
  imageAlt?: string;
};

type Props = Pick<ComponentProps<typeof Section>, "render" | "theme"> & {
  /** First display line. */
  title: string;
  /** Accent line set over the first. */
  accent: string;
  /** Short text beside the title. */
  text?: string;
  /** Numbered steps, played as a scroll carousel. */
  steps?: Step[];
  /** Button label. */
  buttonLabel?: string;
  /** Button destination. */
  buttonHref?: string;
};

const {
  render = true,
  title,
  accent,
  text,
  steps = [],
  buttonLabel,
  buttonHref = "#",
  theme = "dark",
  ...rest
} = Astro.props;
---

{render && title && accent && (
  <Section theme={theme} paddingTop="none" paddingBottom="none" gap="0" data-refill-story {...rest}>
    <div class="refill-story_wrap">
      <div class="refill-story_header">
        <div class="refill-story_title">
          <DisplayPair
            title={title}
            accent={accent}
            mobile={{
              width: 350,
              height: 116,
              column: 350,
              line: { x: -4, y: 0, size: 56 },
              accent: { x: 36, y: 47, size: 60 },
            }}
            desktop={{
              width: 1000,
              height: 330,
              column: 1360,
              line: { x: -10, y: 0, size: 140 },
              accent: { x: 289, y: 113, size: 190 },
            }}
          />
        </div>
        {text && <p class="refill-story_text text-style-small">{text}</p>}
      </div>

      <div class="refill-story_content">
        {steps.length > 0 && (
          <div class="refill-story_visual">
            {steps.map((step) => (
              <div class="refill-story_slide">
                <Image
                  src={step.image}
                  alt={step.imageAlt ?? ""}
                  widths={[320, 480, 720, 960]}
                  sizes="(width >= 64rem) 32vw, 60vw"
                />
              </div>
            ))}
          </div>
        )}

        <div class="refill-story_steps">
          {steps.length > 0 && (
            <ol class="refill-story_list">
              {steps.map((step, index) => (
                <li class="refill-story_step" style={`--_p: ${index === 0 ? 1 : 0}`}>
                  <span class="refill-story_num" aria-hidden="true">
                    <span class="refill-story_num-small">{String(index + 1).padStart(2, "0")}</span>
                    <span class="refill-story_num-large">{String(index + 1).padStart(2, "0")}</span>
                  </span>
                  <span class="refill-story_label">
                    <span class="refill-story_label-small">{step.text}</span>
                    <span class="refill-story_label-large" aria-hidden="true">{step.text}</span>
                  </span>
                </li>
              ))}
            </ol>
          )}
          {buttonLabel && (
            <div class="refill-story_button">
              <Button element="link" href={buttonHref} emphasis="secondary" icon="arrow" class="width-full">
                {buttonLabel}
              </Button>
            </div>
          )}
        </div>
      </div>
    </div>
  </Section>
)}

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  /* Without motion the markup's own state shows: step one active, its photo in place. */
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  /* Scroll per step, in viewport heights, and the length of one step change in seconds. */
  const STEP_SCROLL = 0.7;
  const STEP_DURATION = 0.9;
  /* Scroll held on the last step before the page moves on, in steps. */
  const LAST_HOLD = 1;

  /*
   * Each step label holds two set texts, a small one-liner and the large active
   * version. Their heights are measured so the row can ease between them while
   * the texts crossfade; nothing re-wraps during the change.
   */
  function measureLabels(section: HTMLElement) {
    section.querySelectorAll<HTMLElement>(".refill-story_label").forEach((label) => {
      const small = label.querySelector<HTMLElement>(".refill-story_label-small");
      const large = label.querySelector<HTMLElement>(".refill-story_label-large");
      if (!small || !large) return;
      label.style.setProperty("--_hs", `${small.offsetHeight}px`);
      label.style.setProperty("--_hl", `${large.offsetHeight}px`);
      label.classList.add("is-measured");
    });
  }

  document.querySelectorAll<HTMLElement>("[data-refill-story]").forEach((section) => {
    const steps = gsap.utils.toArray<HTMLElement>(".refill-story_step", section);
    const slides = gsap.utils.toArray<HTMLElement>(".refill-story_slide", section);

    measureLabels(section);
    const list = section.querySelector(".refill-story_list");
    if (list) new ResizeObserver(() => measureLabels(section)).observe(list);
    document.fonts?.ready.then(() => measureLabels(section));

    if (prefersReduced.matches || steps.length === 0) return;

    const photo = (slide: HTMLElement | undefined) => slide?.querySelector("img") ?? null;

    /* Opening state: no step active, no photo. */
    gsap.set(steps, { "--_p": 0 });
    gsap.set(slides, { yPercent: 100, opacity: 1 });
    gsap.set(slides.map(photo), { yPercent: -60 });

    /* One change per second of timeline: state n sits at time n. */
    const changes = gsap.timeline({ paused: true, defaults: { duration: 1, ease: "power3.inOut" } });
    steps.forEach((step, index) => {
      const slide = slides[index];
      const previous = slides[index - 1];

      /* The step text grows while the one before shrinks back. */
      changes.to(step, { "--_p": 1 }, index);
      if (index > 0) changes.to(steps[index - 1], { "--_p": 0 }, index);

      /* The photo leaves upward out of its frame as the next one rises in. */
      if (slide) changes.to(slide, { yPercent: 0 }, index).to(photo(slide), { yPercent: 0 }, index);
      if (previous) changes.to(previous, { yPercent: -100 }, index).to(photo(previous), { yPercent: 60 }, index);
    });

    /* Scrolling only picks the step; each change then plays at its own pace. */
    let current = 0;
    const show = (state: number) => {
      if (state === current) return;
      const distance = Math.abs(state - current);
      current = state;
      changes.tweenTo(state, { duration: STEP_DURATION * Math.sqrt(distance), ease: "none" });
    };

    const scrollUnits = steps.length - 1 + LAST_HOLD + 0.7;
    ScrollTrigger.create({
      trigger: section,
      start: "top top",
      end: () => `+=${window.innerHeight * STEP_SCROLL * scrollUnits}`,
      pin: true,
      /* The parent is a flex column, where GSAP turns spacing off by default. */
      pinSpacing: true,
      invalidateOnRefresh: true,
      onUpdate: (self) => {
        /* Step one shows after a short scroll; the last one holds for LAST_HOLD. */
        const units = self.progress * scrollUnits;
        show(Math.min(steps.length, Math.floor(units + 0.7)));
      },
    });
  });
</script>

<style is:global>
  @layer components {
    .refill-story_wrap {
      /* Step text: small and active sizes, both held to the viewport height. */
      --_small: min(1.0625rem, 2.6svh);
      --_large: min(1.625rem, 4svh);
      --_row: min(0.625rem, 1.4svh);
      width: 100%;
      /* vh and rem first, for browsers without svh. */
      height: 100vh;
      height: 100svh;
      display: flex;
      flex-direction: column;
      gap: min(1rem, 2svh);
      padding-top: 5rem;
      padding-top: clamp(5rem, 11svh, 7.5rem);
      padding-bottom: 1.25rem;
      padding-bottom: clamp(1.25rem, 4svh, 2.5rem);
    }

    .refill-story_header {
      display: flex;
      flex-direction: column;
      gap: min(0.75rem, 1.5svh);
    }

    /* Keep the title to about a quarter of the screen height. */
    .refill-story_title {
      width: min(100%, 72svh);
    }

    .refill-story_text {
      max-width: 20.625rem;
    }

    /* Short phones: give the photo the room. */
    @media (width < 48rem) and (height < 45rem) {
      .refill-story_text {
        display: none;
      }
    }

    .refill-story_content {
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
      gap: min(1rem, 2svh);
    }

    /* Photo frame: fills the free height, slides move inside it. */
    .refill-story_visual {
      position: relative;
      flex: 1;
      min-height: 0;
      height: 100%;
      aspect-ratio: 2 / 3;
      align-self: center;
      overflow: hidden;
    }

    .refill-story_slide {
      position: absolute;
      inset: 0;
      overflow: hidden;
      will-change: transform;

      /* Without the script only the first photo shows. */
      &:not(:first-child) {
        opacity: 0;
      }

      & img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        will-change: transform;
      }
    }

    .refill-story_steps {
      display: flex;
      flex-direction: column;
      gap: min(1rem, 2svh);
    }

    .refill-story_step {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      padding-block: var(--_row);
      border-top: var(--border-width) solid var(--text);
    }

    /* Numbers: the small sans and the large serif crossfade as the step grows. */
    .refill-story_num {
      display: grid;
      flex: none;
      /* Sized for the large number, so the label never shifts sideways. */
      width: calc(var(--_large) * 0.5 * 1.3);
      font-size: calc(0.8125rem + (var(--_large) * 0.5 - 0.8125rem) * var(--_p));
      line-height: 1.35;

      & > span {
        grid-area: 1 / 1;
      }
    }

    /* Same timing as the labels: out in the first half, in during the second. */
    .refill-story_num-small {
      font-family: var(--primary-family);
      opacity: clamp(0, 1 - var(--_p) * 2, 1);
    }

    .refill-story_num-large {
      font-family: var(--serif-family);
      opacity: clamp(0, var(--_p) * 2 - 1, 1);
    }

    /*
     * Label: the small text leaves upward in the first half of the change,
     * the large one rises in during the second, and the row height eases
     * between their measured heights.
     */
    .refill-story_label {
      position: relative;
      display: block;
      flex: 1;
      max-width: 30.1875rem;
      font-family: var(--serif-family);

      &.is-measured {
        height: calc(var(--_hs) + (var(--_hl) - var(--_hs)) * var(--_p));
        overflow: hidden;
      }
    }

    .refill-story_label-small,
    .refill-story_label-large {
      display: block;
      will-change: transform, opacity;
    }

    .refill-story_label-small {
      font-size: var(--_small);
      line-height: 1.2;
      opacity: clamp(0, 1 - var(--_p) * 2, 1);
      transform: translateY(calc(var(--_p) * -60%));
    }

    .refill-story_label-large {
      position: absolute;
      inset: 0 0 auto;
      font-size: var(--_large);
      line-height: 1.05;
      opacity: clamp(0, var(--_p) * 2 - 1, 1);
      transform: translateY(calc((1 - var(--_p)) * 40%));
    }

    .refill-story_button {
      display: flex;
      flex-direction: column;
    }

    @media (width >= 48rem) {
      .refill-story_wrap {
        --_small: min(1.5rem, 3svh);
        --_large: min(3rem, 5.5svh);
        --_row: min(1.125rem, 1.8svh);
      }

      .refill-story_step {
        gap: 2.5rem;
      }

      .refill-story_title {
        width: min(100%, 107svh);
      }
    }

    @media (width >= 64rem) {
      .refill-story_wrap {
        --_small: min(1.875rem, 3.2svh);
        --_large: min(4rem, 6svh);
        --_row: min(1.375rem, 2svh);
        gap: min(1.5rem, 2.5svh);
      }

      .refill-story_header {
        flex-direction: row;
        align-items: start;
        justify-content: space-between;
      }

      .refill-story_text {
        width: 20.625rem;
      }

      .refill-story_content {
        flex-direction: row-reverse;
        align-items: end;
        justify-content: space-between;
        gap: 1.25rem;
      }

      .refill-story_visual {
        flex: none;
        align-self: stretch;
      }

      .refill-story_steps {
        flex: none;
        width: 35rem;
        gap: min(2.5rem, 4svh);
      }

      .refill-story_button {
        width: 27.5rem;
      }
    }
  }
</style>
