---
import { Image } from "astro:assets";
import Section from "@/components/wrapper/Section.astro";
import DisplayPair from "@/components/content/DisplayPair.astro";

type Props = {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** First display line. */
  title: string;
  /** Accent line. */
  accent: string;
  /** Photo beside the title. */
  image: ImageMetadata;
  /** Photo description. */
  imageAlt?: string;
  /** Serif line under the photo. */
  text: string;
  /** Numbered benefits. */
  benefits?: { title: string; text: string }[];
};

const { render = true, title, accent, image, imageAlt = "", text, benefits = [] } = Astro.props;
---

{render && title && accent && (
  <Section theme="cream" gap="0">
    <div class="product-statement_wrap">
      <div class="product-statement_top">
        <DisplayPair
          title={title}
          accent={accent}
          variant="display"
          mobile={{
            width: 350,
            height: 125,
            column: 350,
            line: { x: -4, y: 0, size: 72 },
            accent: { x: 26, y: 54, size: 66 },
          }}
          desktop={{
            width: 900,
            height: 340,
            column: 900,
            line: { x: -10, y: 0, size: 200 },
            accent: { x: 72, y: 150, size: 190 },
          }}
        />
        <div class="product-statement_aside">
          <div class="product-statement_visual">
            <Image src={image} alt={imageAlt} widths={[400, 700, 1000]} sizes="(width >= 64rem) 31vw, 100vw" />
          </div>
          <p class="text-style-h5">{text}</p>
        </div>
      </div>

      {benefits.length > 0 && (
        <ol class="product-statement_benefits">
          {benefits.map((benefit, index) => (
            <li class="product-statement_benefit">
              <span class="text-style-caption">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="text-style-h5">{benefit.title}</h3>
              <p class="text-style-main">{benefit.text}</p>
            </li>
          ))}
        </ol>
      )}
    </div>
  </Section>
)}

<style is:global>
  @layer components {
    .product-statement_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      /* 40px on mobile → 100px at 1440. */
      gap: clamp(2.5rem, 1.107rem + 5.714vw, 6.25rem);
    }

    .product-statement_top {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem var(--site-gutter);
    }

    .product-statement_aside {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .product-statement_visual {
      position: relative;
      aspect-ratio: 440 / 420;
      overflow: hidden;
      background-color: var(--light-200);

      & img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    .product-statement_benefits {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem var(--site-gutter);
    }

    .product-statement_benefit {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding-top: 1.25rem;
      border-top: var(--border-width) solid var(--text);
    }

    @media (width >= 48rem) {
      .product-statement_benefits {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (width >= 64rem) {
      .product-statement_top {
        grid-template-columns: minmax(0, 900fr) minmax(0, 440fr);
        justify-content: space-between;
      }
    }
  }
</style>
