---
import type { ComponentProps } from "astro/types";
import { Image } from "astro:assets";
import Section from "@/components/wrapper/Section.astro";
import Button from "@/components/Button.astro";
import poster from "@/assets/images/lipstick-hero-start.png";

type Props = Pick<
  ComponentProps<typeof Section>,
  "render" | "theme" | "paddingTop" | "paddingBottom"
> & {
  /** First display line. */
  title: string;
  /** Accent line set over the first. */
  accent: string;
  /** Short introduction beside the button. */
  text?: string;
  /** Button label. */
  buttonLabel?: string;
  /** Button destination. */
  buttonHref?: string;
  /** Facts along the bottom rule. */
  meta?: string[];
  /** 3D model URL. Omit to show only the still render. */
  model?: string;
  /** Studio HDRI that lights the model. */
  environment?: string;
};

const {
  render = true,
  title,
  accent,
  text,
  buttonLabel,
  buttonHref = "#",
  meta = [],
  model,
  environment,
  theme = "cream",
  paddingTop = "none",
  paddingBottom = "none",
  ...rest
} = Astro.props;
---

{render && title && accent && (
  <Section
    theme={theme}
    paddingTop={paddingTop}
    paddingBottom={paddingBottom}
    gap="0"
    data-hero-home
    {...rest}
  >
    <div class="hero-home_wrap">
      <div class="hero-home_stage">
        <h1 class="hero-home_title">
          <span class="hero-home_line text-style-display">{title}</span>
          <span class="hero-home_accent text-style-accent">{accent}</span>
        </h1>
        <div class="hero-home_object" data-model={model} data-environment={environment}>
          <Image
            class="hero-home_poster"
            src={poster}
            alt=""
            widths={[400, 600, 900, 1200]}
            sizes="(width >= 48rem) 44vw, 75vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="hero-home_cta">
        {text && <p class="hero-home_text text-style-large">{text}</p>}
        {buttonLabel && (
          <div class="hero-home_button">
            <Button element="link" href={buttonHref} size="large" icon="arrow">
              {buttonLabel}
            </Button>
          </div>
        )}
      </div>

      {meta.length > 0 && (
        <ul class="hero-home_meta text-style-caption">
          {meta.map((item) => <li>{item}</li>)}
        </ul>
      )}
    </div>
  </Section>
)}

{/* No-JS fallback: show the title without its intro. */}
<noscript>
  <style>
    .hero-home_line,
    .hero-home_accent {
      opacity: 1;
    }
  </style>
</noscript>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import type { TwistProgress } from "@/scripts/lipstick-twist.ts";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  /* Title intro: the display line from the left, the accent from the right a beat later. */
  document.querySelectorAll<HTMLElement>("[data-hero-home]").forEach((section) => {
    const line = section.querySelector(".hero-home_line");
    const accent = section.querySelector(".hero-home_accent");
    if (!line || !accent) return;

    if (prefersReduced.matches) {
      gsap.set([line, accent], { opacity: 1 });
      return;
    }

    gsap
      .timeline({ defaults: { duration: 1.2, ease: "power3.out" } })
      .fromTo(line, { opacity: 0, xPercent: -8 }, { opacity: 1, xPercent: 0 }, 0)
      .fromTo(accent, { opacity: 0, xPercent: 8 }, { opacity: 1, xPercent: 0 }, 0.15);
  });

  /* Scroll per twist, in viewport heights. */
  const SCROLL_LENGTH = 1;

  document.querySelectorAll<HTMLElement>("[data-hero-home]").forEach((section) => {
    const holder = section.querySelector<HTMLElement>(".hero-home_object");
    const model = holder?.dataset.model;
    const environment = holder?.dataset.environment;
    if (!holder || !model) return;

    /*
     * The pin is set up right away, not when the model arrives, so every
     * ScrollTrigger further down the page measures the final layout.
     */
    let progress: TwistProgress | undefined;
    if (!prefersReduced.matches) {
      const listeners = new Set<() => void>();
      const scroll = { value: 0 };
      progress = {
        get value() {
          return scroll.value;
        },
        subscribe: (callback) => void listeners.add(callback),
      };
      gsap.to(scroll, {
        value: 1,
        ease: "none",
        onUpdate: () => listeners.forEach((callback) => callback()),
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: () => `+=${window.innerHeight * SCROLL_LENGTH}`,
          pin: true,
          /* The parent is a flex column, where GSAP turns spacing off by default. */
          pinSpacing: true,
          scrub: 0.6,
          invalidateOnRefresh: true,
          /* First on the page: measure it before the triggers below it. */
          refreshPriority: 10,
        },
      });
    }

    /* Reduced motion: the end state, without the scroll twist. */
    const start = () =>
      import("@/scripts/lipstick-twist.ts").then(({ mountLipstickTwist }) =>
        mountLipstickTwist({ holder, model, environment, progress }),
      );

    if ("requestIdleCallback" in window) {
      requestIdleCallback(start, { timeout: 1200 });
    } else {
      setTimeout(start, 200);
    }
  });
</script>

<style is:global>
  @layer components {
    .hero-home_wrap {
      --_nav-clearance: 4.5rem;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      padding-top: var(--_nav-clearance);
      padding-bottom: 2.5rem;
    }

    /* Display pair artboard — mobile 350 × 357 */
    .hero-home_stage {
      --_u: 1cqw;
      --_w: 350;
      position: relative;
      container-type: inline-size;
      aspect-ratio: 350 / 357;
      /* Title and lipstick scale as one piece, held to the screen height. */
      width: min(88%, 42svh);
    }

    .hero-home_title {
      margin: 0;
      font: inherit;
      text-box: normal;
    }

    .hero-home_line,
    .hero-home_accent {
      position: absolute;
      display: block;
      white-space: nowrap;
      text-box: normal;
      /* Hidden until the intro plays; see the script and the no-JS fallback. */
      opacity: 0;
    }

    .hero-home_line {
      left: calc(-4 / var(--_w) * 100 * var(--_u));
      top: calc(14 / var(--_w) * 100 * var(--_u));
      font-size: calc(88 / var(--_w) * 100 * var(--_u));
      color: var(--text);
    }

    .hero-home_accent {
      left: calc(165 / var(--_w) * 100 * var(--_u));
      top: calc(92 / var(--_w) * 100 * var(--_u));
      font-size: calc(92 / var(--_w) * 100 * var(--_u));
    }

    .hero-home_object {
      position: absolute;
      left: calc(50 / var(--_w) * 100 * var(--_u));
      top: calc(35 / var(--_w) * 100 * var(--_u));
      width: calc(260 / var(--_w) * 100 * var(--_u));
      aspect-ratio: 4 / 5;
      pointer-events: none;

      & .hero-home_poster {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      /*
       * The canvas bleeds 20% past the frame on every side (BLEED in
       * lipstick-twist.ts), so the camera move never clips the lipstick.
       */
      & canvas {
        position: absolute;
        left: -20%;
        top: -20%;
        width: 140%;
        max-width: none;
        height: 140%;
        background: transparent;
        visibility: hidden;
      }

      /* Swap in one frame: the poster and the first render match, so nothing doubles up. */
      &.is-live canvas {
        visibility: visible;
      }

      &.is-live .hero-home_poster {
        visibility: hidden;
      }
    }

    .hero-home_cta {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
    }

    .hero-home_button {
      display: flex;
      flex-direction: column;
    }

    .hero-home_meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      padding-top: 0.875rem;
      border-top: var(--border-width) solid var(--text);
    }

    /* Desktop: the lipstick on the left, the title on the right. */
    @media (width >= 48rem) {
      .hero-home_stage {
        --_stage-h: min(60svh, 44vw);
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        grid-template-rows: 100%;
        align-items: center;
        column-gap: clamp(1.5rem, 5vw, 6rem);
        width: 100%;
        height: var(--_stage-h);
        aspect-ratio: auto;
        container-type: normal;
      }

      .hero-home_object {
        position: relative;
        grid-area: 1 / 1;
        left: auto;
        top: auto;
        width: calc(var(--_stage-h) * 0.8);
        height: var(--_stage-h);
      }

      /* Title artboard — 760 × 360, the accent set below and to the right. */
      .hero-home_title {
        --_w: 760;
        grid-area: 1 / 2;
        position: relative;
        container-type: inline-size;
        aspect-ratio: 760 / 360;
        width: min(100%, var(--_stage-h) * 760 / 360);
      }

      .hero-home_line {
        left: calc(-6 / var(--_w) * 100 * var(--_u));
        top: 0;
        font-size: calc(185 / var(--_w) * 100 * var(--_u));
      }

      .hero-home_accent {
        left: calc(250 / var(--_w) * 100 * var(--_u));
        top: calc(150 / var(--_w) * 100 * var(--_u));
        font-size: calc(200 / var(--_w) * 100 * var(--_u));
      }
    }

    @media (width >= 64rem) {
      .hero-home_wrap {
        --_nav-clearance: 6rem;
        min-height: 100svh;
        justify-content: end;
      }

      /* Centre the title in the free height above the CTA row. */
      .hero-home_stage {
        margin-block: auto;
      }

      .hero-home_cta {
        flex-direction: row;
        align-items: end;
        justify-content: space-between;
      }

      .hero-home_text {
        width: 20.625rem;
      }

      .hero-home_button {
        width: 27.5rem;
      }

      .hero-home_meta {
        justify-content: space-between;
      }
    }
  }
</style>
