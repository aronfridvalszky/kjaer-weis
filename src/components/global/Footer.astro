---
import Icon from "@/components/media/Icon.astro";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import logo from "@/assets/logo/kjaerweis-logo.svg";
import { SITE_NAME } from "@/consts.ts";

type Link = { label: string; href: string };
type Column = { title: string; links: Link[] };

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const link = (label: string): Link => ({ label, href: "#" });

const columns: Column[] = [
  {
    title: "Shop",
    links: ["Skin Care", "Cosmetics", "Refills", "Sets", "Gift cards"].map(link),
  },
  {
    title: "Purpose",
    links: ["Our Story", "Ingredients", "Sustainability", "The Guide"].map(link),
  },
  {
    title: "Help",
    links: ["FAQs", "How to Refill", "Shipping & Returns", "Contact"].map(link),
  },
  {
    title: "Follow",
    links: ["Instagram", "YouTube", "TikTok"].map(link),
  },
];
---

{render && (
  <footer class="footer_wrap theme-dark">
    <div class="footer_inner">
      <div class="footer_newsletter">
        <h2 class="footer_title text-style-h3">
          Refill reminders,<br />rituals &amp; first looks.
        </h2>
        <form class="footer_form" data-newsletter novalidate>
          <label class="sr-only" for="footer-email">Email address</label>
          <input
            class="footer_input"
            id="footer-email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="Your email address"
            required
          />
          <button class="footer_submit" type="submit" aria-label="Subscribe">
            <ArrowRight stroke-width={1.25} aria-hidden="true" />
          </button>
          <p class="footer_status text-style-caption" role="status" aria-live="polite"></p>
        </form>
      </div>

      <nav class="footer_columns" aria-label="Footer">
        {columns.map((column) => (
          <div class="footer_column">
            <h3 class="text-style-overline">{column.title}</h3>
            <ul class="footer_links">
              {column.links.map((item) => (
                <li>
                  <a class="footer_link" href={item.href}>{item.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>

      <a class="footer_logo" href="/" aria-label={SITE_NAME}>
        <Icon src={logo} variant="full-width" />
      </a>

      <div class="footer_bottom text-style-caption">
        <p>&copy; <span data-year>2026</span> Kjaer Weis — concept by Aron Fridvalszky</p>
        <p>Certified organic · Vegan · Refillable</p>
      </div>
    </div>
  </footer>
)}

<script>
  document.querySelectorAll<HTMLElement>("[data-year]").forEach((year) => {
    year.textContent = new Date().getFullYear().toString();
  });

  document.querySelectorAll<HTMLFormElement>("[data-newsletter]").forEach((form) => {
    const input = form.querySelector("input");
    const status = form.querySelector<HTMLElement>(".footer_status");
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!input || !status) return;
      if (!input.checkValidity()) {
        status.textContent = "Please enter a valid email address.";
        input.focus();
        return;
      }
      status.textContent = "Thank you — you're on the list.";
      form.reset();
    });
  });
</script>

<style is:global>
  @layer components {
    .footer_wrap {
      display: flex;
      justify-content: center;
      padding: var(--section-space-medium) var(--site-margin) 2.5rem;
      background-color: var(--background);
      color: var(--text);
    }

    .footer_inner {
      /* 40px on mobile → 80px at 1440. */
      --_gap: clamp(2.5rem, 1.571rem + 3.81vw, 5rem);
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      flex-direction: column;
      gap: var(--_gap);
    }

    .footer_newsletter {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .footer_title {
      margin: 0;
      line-height: 1.05;
    }

    .footer_form {
      position: relative;
      display: flex;
      align-items: end;
    }

    .footer_input {
      flex: 1;
      min-width: 0;
      align-self: stretch;
      padding: 0 0 0.875rem;
      border: 0;
      border-bottom: var(--border-width) solid currentcolor;
      border-radius: 0;
      background: none;
      color: inherit;
      font: inherit;
      font-size: var(--text-large);
      line-height: 1.45;
      outline: none;

      &::placeholder {
        color: inherit;
        opacity: 1;
      }

      &:focus-visible {
        border-bottom-color: var(--brand-500);
      }
    }

    .footer_submit {
      flex: none;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 3.5rem;
      height: 3.5rem;
      background-color: var(--brand-500);
      color: var(--brand-text);
      transition: background-color var(--hover-duration) var(--hover-ease);

      & svg {
        width: 1.375rem;
        height: 1.375rem;
      }

      @media (hover: hover) {
        &:hover {
          background-color: color-mix(in lab, var(--brand-500), black 20%);
        }
      }
    }

    .footer_status {
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 0;
      margin: 0;
    }

    .footer_columns {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem var(--site-gutter);
    }

    .footer_column {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .footer_links {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .footer_link {
      font-size: var(--text-main);
      line-height: 1.5;
      color: inherit;
      text-decoration: none;
      transition: opacity var(--hover-duration) var(--hover-ease);

      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .footer_logo {
      display: block;
      width: 100%;
    }

    .footer_bottom {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      padding-top: 1rem;
      border-top: var(--border-width) solid currentcolor;

      & p {
        margin: 0;
      }
    }

    @media (width >= 48rem) {
      .footer_columns {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }

      .footer_bottom {
        flex-direction: row;
        justify-content: space-between;
        gap: var(--site-gutter);
      }
    }

    @media (width >= 64rem) {
      .footer_newsletter {
        flex-direction: row;
        align-items: end;
        justify-content: space-between;
        gap: var(--site-gutter);
      }

      .footer_form {
        flex: 0 1 34.6875rem;
        gap: 0.625rem;
      }

      .footer_submit {
        width: 4rem;
      }
    }
  }
</style>
